{
  "name": "droid-mobile",
  "version": "2.0.0-native-alpha",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Native Android Compose client with isolated TypeScript Droid SDK backend.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @droidmobile/native-bridge",
    "typecheck": "npm run typecheck -w @droidmobile/native-bridge && npm run typecheck -w @droidmobile/daemon-client",
    "test": "vitest run --project unit packages/daemon-client --maxWorkers=4",
    "android:release": "cd apps/mobile/android && bash ./gradlew assembleRelease",
    "android:debug": "cd apps/mobile/android && bash ./gradlew assembleDebug",
    "scan:secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/scan-repo-secrets.ps1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
